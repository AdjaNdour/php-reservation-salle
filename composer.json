{
    "name": "adja/reservation-salles",
    "description": "Application de gestion des réservations de salles universitaires sans framework complet",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "AdjaNdour",
            "email": "adjacourandour4@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2 || ^8.3",
        "nikic/fast-route": "^1.3",
        "respect/validation": "^2.4",
        "illuminate/database": "^12.0",
        "php-di/php-di": "^7.0",
        "vlucas/phpdotenv": "^5.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Database\\": "database/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "kiki": "php bin/console",
        "migrate": "php bin/console migrate",
        "seed": "php bin/console seed",
        "rollback": "php bin/console migrate:rollback"
    }
}
